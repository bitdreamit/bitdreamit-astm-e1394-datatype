<component name="ArtifactManager">
  <artifact type="jar" build-on-make="false" name="bitdreamit-astm-e1394-datatype-client">
    <output-path>$PROJECT_DIR$/out/artifacts/bitdreamit_astm_e1381_transmission_client</output-path>
    <root id="archive" name="bitdreamit-astm-e1394-datatype-client.jar">
      <!--
        Client JAR contents (matches distribution/build.sh rule #7):
          - compiled classes from the `shared` module (Constants,
            Properties, Frame, FrameException, RetryMetrics)
          - compiled classes from the `client` module
            (ASTME1381ClientProvider,
            ASTME1381TransmissionModeClientPlugin,
            ASTME1381TransmissionModeSettingsPanel)

        NOTE (v1.1.7): plugin.xml and transmissionmode.xml are NO
        LONGER bundled inside the JARs. They are deployed as separate
        files at the extension folder root, per the Mirth Connect 4.x
        convention. Mirth's extension loader reads them from the
        filesystem, not from inside the JARs.

        To build via IntelliJ IDEA:
          Build -> Build Artifacts... -> bitdreamit-astm-e1394-datatype-client -> Build

        Output path:
          $PROJECT_DIR$/out/artifacts/bitdreamit_astm_e1381_transmission_client/
            bitdreamit-astm-e1394-datatype-client.jar

        For production deployment, also copy:
          $PROJECT_DIR$/plugin.xml
          $PROJECT_DIR$/transmissionmode.xml
        to the Mirth extension folder alongside this JAR.
      -->
      <element id="module-output" name="shared" />
      <element id="module-output" name="client" />
    </root>
  </artifact>
</component>
